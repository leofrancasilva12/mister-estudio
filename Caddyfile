# Portaria do Estúdio: HTTPS automático. O login agora é feito pela tela do próprio app.
{$DOMINIO} {
	encode zstd gzip

	# /mcp/... vai para o MCP do Estúdio; o resto, para o app
	handle /mcp* {
		reverse_proxy estudio-mcp:3333
	}
	handle {
		reverse_proxy estudio:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
