# Portaria do MCP: /mcp/... vai para o conector; o resto responde que não há site aqui.
{$DOMINIO} {
	encode zstd gzip

	handle /mcp* {
		reverse_proxy estudio-mcp:3333
	}
	handle /pesquisa/* {
		reverse_proxy pesquisa-mcp:3334
	}
	handle {
		respond "Mister Studio MCP" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
