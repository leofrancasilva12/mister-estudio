# Copie para .env e preencha:  cp .env.example .env && nano .env
# O .env fica SÓ na VPS (nunca vai para o GitHub). Depois: chmod 600 .env

# Endereço da VPS (o HTTPS é automático)
DOMINIO=srv2085023.hstgr.cloud

# Sua chave do Kie.ai (painel do Kie.ai > API Keys)
KIE_API_KEY=cole-sua-chave-aqui

# Chave do conector do Claude. Gere com: openssl rand -hex 32
MCP_TOKEN=

# Teto de créditos por dia gastos pelo Claude (0 = sem teto)
MCP_LIMITE_CREDITOS_DIA=600

# kie = de verdade | simulado = imagens de exemplo, sem gastar
MCP_PROVEDOR=kie
