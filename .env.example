# Copie para .env e preencha:  cp .env.example .env && nano .env

# Endereço do Estúdio (por enquanto, o nome da própria VPS)
DOMINIO=srv2085023.hstgr.cloud

# Sua chave do Kie.ai (painel do Kie.ai > API Keys). Fica SÓ aqui, no servidor.
KIE_API_KEY=cole-sua-chave-aqui

# true = testa sem gastar créditos (resultados de exemplo) | false = Kie.ai de verdade
KIE_SIMULADO=true

# Login do Estúdio (a tela de login do app usa estes dois)
ESTUDIO_USUARIO=leo
# Gere o hash da senha com o comando do guia e cole ENTRE ASPAS SIMPLES
ESTUDIO_SENHA_HASH='cole-o-hash-aqui'

# Opcional: chave que assina as sessões. Sem ela, o app cria uma a partir da senha.
# Para gerar: openssl rand -hex 32
# SESSAO_SEGREDO=

# Tamanho máximo de arquivo enviado (MB)
UPLOAD_LIMITE_MB=50

# Chave do MCP (conector do Claude). Gere com: openssl rand -hex 32
MCP_TOKEN=
# Teto de créditos por dia gastos pelo Claude via MCP (0 = sem teto)
MCP_LIMITE_CREDITOS_DIA=600
# kie = de verdade | simulado = imagens de exemplo, sem gastar
MCP_PROVEDOR=kie
